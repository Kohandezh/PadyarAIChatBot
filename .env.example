# ============================================
# INOTEX Chatbot Configuration
# ============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Every value below is a PLACEHOLDER. Never commit real credentials here —
# real values belong in .env, which is gitignored.

# --- Required ---
# OpenAI API key (used via GapGPT proxy)
OPENAI_API_KEY=sk-your-api-key-here

# Any OpenAI-compatible endpoint. Point this at a different gateway or a
# self-hosted model server if you are not using GapGPT.
# NOTE: the admin panel (Settings -> AI) overrides both the key and this base
# URL once they are entered there.
OPENAI_API_BASE=https://api.gapgpt.app/v1

# --- Text to speech (optional `tts` module) ---
# The Persian Chatterbox service (deploy/tts/server.py). It listens on loopback
# with no authentication of its own, which is exactly why the admin panel
# proxies it — never publish this port.
TTS_URL=http://127.0.0.1:8003
# Seconds to wait for a synthesis (a cache miss is roughly real-time, so a
# paragraph legitimately takes a while) and for a health/voice-list call.
TTS_TIMEOUT=180
TTS_STATUS_TIMEOUT=5

# --- Environment ---
# Which kind of install this is: development | staging | production.
#
# This is the ONLY thing that decides whether the production configuration gate
# runs (app/prodcheck.py). It is deliberately separate from COOKIE_SECURE and
# every other setting the gate CHECKS: an earlier version keyed off
# COOKIE_SECURE, so a production server that forgot to set it classified itself
# as development and skipped validation entirely — the misconfiguration
# switching off the check meant to catch it.
#
#   development  (default)  nothing blocks; findings are logged
#   staging                 evaluates the production rules and logs what would
#                           block, but still boots
#   production              REFUSES TO START on an unsafe setting
#
# An unrecognised value (e.g. "prod") is an error, not a silent fallback.
PADYAR_ENV=development
# Production deployments MUST set:
#   PADYAR_ENV=production

# --- Security ---
# Secret used to sign chat tokens AND to derive the key that encrypts stored
# secrets (the SMS gateway password/API key, written below as enc:... values).
# Leave empty to auto-generate a stable key on first run (stored in the DB).
# Set a value to pin it across reinstalls.
# WARNING: changing this value — or losing the database while it is empty —
# makes existing enc:... values undecryptable. The app then reports "SMS not
# configured" and the credentials must be re-entered in the admin panel. It
# never sends an unreadable value to a gateway.
SECRET_KEY=

# Send the admin cookie only over HTTPS. Keep false for local http dev.
# In production (HTTPS), set this to true.
# This flag is also the app's "production" marker: with COOKIE_SECURE=true the
# OTP dev outbox is refused, so a real SMS provider must be configured.
COOKIE_SECURE=false

# Domain(s) allowed to embed/call the public chat, comma-separated.
# localhost and 127.0.0.1 are always allowed for local dev.
# Example: ALLOWED_ORIGINS=chat.mycompany.com,www.mycompany.com
ALLOWED_ORIGINS=inotex.com

# First-install admin account (only used to seed a brand-new database).
# Leave ADMIN_PASSWORD empty to auto-generate one into ADMIN_CREDENTIALS.txt.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=
ADMIN_SECURITY_ANSWER=

# --- Server / paths ---
# Bind address and port for `python main.py` (dev server only; in production
# uvicorn/gunicorn is started with its own flags).
HOST=127.0.0.1
PORT=8000

# SQLite database file. Default is chat_history.db in the project root.
# DB_PATH=/absolute/path/to/chat_history.db

# --- DATABASE ENGINE (production = PostgreSQL 16) ------------------------
# SQLite is no longer the production store. It remains only as the migration
# source, the test-suite backend, and a rollback artifact.
DB_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/padyar
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=10
DB_POOL_MAX_LIFETIME=1800

# bcrypt work factor. 12 is production strength; the test suite lowers it
# because one hash costs ~580 ms. NEVER lower this in production.
# BCRYPT_ROUNDS=12

# DEPLOYMENT REQUIREMENTS
#   * PostgreSQL 16, server_encoding UTF8 (Persian content is stored directly).
#   * A dedicated least-privilege role that OWNS the `app` and `observability`
#     schemas. Do not run the application as a superuser.
#   * Apply migrations/ in order before first boot; the app does NOT create
#     production tables at runtime.
#   * pg_dump/pg_restore must be on PATH (or set PG_BIN_DIR) for the Backup
#     Centre to work — it uses --format=custom, never a file copy.
#   * Set statement_timeout and idle_in_transaction_session_timeout on the
#     ROLE, so one stuck admin query cannot hold a connection forever:
#       ALTER ROLE padyar_app SET statement_timeout = '30s';
#       ALTER ROLE padyar_app SET idle_in_transaction_session_timeout = '60s';
#   * max_connections must exceed DB_POOL_MAX_SIZE x (number of app processes).
#   * Require TLS between app and database when they are not on one host.
# PG_BIN_DIR=/usr/local/opt/postgresql@16/bin

# Logging lives in its OWN SQLite file, separate from the chatbot database.
# SQLite locks per FILE, so a burst of log writes must not be able to block the
# chatbot's own reads. Leave this unset unless you are moving the log store.
# LOGS_DB_PATH=/absolute/path/to/application_logs.db

# Log output format. Set to "json" for single-line structured records a log
# shipper (Loki/ELK/CloudWatch) can index. Anything else = human-readable.
# LOG_FORMAT=json

# --- Optional ---
# Base URL/path prefix for video files. Default is the RELATIVE path "/media/videos",
# which resolves against the current host — so it works on local http and
# production https with no change. Only set an absolute URL to serve videos
# from a separate CDN host (e.g. https://cdn.example.com/videos).
VIDEO_BASE_URL=/media/videos

# Seed the bundled INOTEX knowledge base into a brand-new database. Set to
# false for an installation that will import its own content instead.
# Existing content is never overwritten either way.
SEED_DEFAULT_CONTENT=true

# --- Modules ---
# Comma-separated list of optional modules to enable.
# Core modules (chat, admin, search, dataset, theme) are always enabled.
# Available optional modules:
#   voice        - Voice input via Whisper API (/api/transcribe)
#   video        - Video response upload and serving
#   registration - Visitor registration + SMS verification
#                  (/verify, /api/auth/otp/*, /api/visit-plan)
#   tts          - Persian text-to-speech control panel + voice cloning
#                  (Admin -> AI -> Text to speech). Needs the Chatterbox
#                  service from deploy/tts/ running at TTS_URL.
#
# Leave empty to enable all optional modules (default behavior).
# Example: ENABLED_MODULES=voice,video,registration,tts
ENABLED_MODULES=

# --- Trusted proxy / client IP ---
# Which address the app treats as the client, for rate limiting and for the ip
# recorded on audit and security log rows.
#
# Both settings default to off, and that is the safe default: forwarding
# headers are attacker-controlled unless a proxy you run rewrites them. With
# neither set the app ignores them and uses the connecting socket address.
#
# Set this to true when the app is served through a Cloudflare Tunnel. The
# CF-Connecting-IP header is then believed, because Cloudflare rewrites it.
TRUST_CLOUDFLARE=false
#
# How many proxies you operate sit in front of the app. The Nth entry counted
# from the RIGHT of X-Forwarded-For is used. Rightmost entries were appended by
# your own infrastructure; the leftmost is whatever the client sent, so it is
# never trusted. 0 disables the header.
# Example: one nginx in front -> TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_HOPS=0

# --- Chat rate limit (per client IP) ---
# Exhibition/booth reality: many visitors can share one NAT'd IP, so keep the
# limit generous. Defaults: 20 requests per 60 seconds.
# Counters live in the database (shared across workers, survive restarts).
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60

# --- Request body ceiling ---
# Backstop on Content-Length for any single request. Video uploads stream to
# disk and legitimately need a lot; this exists to stop one request from
# buffering an unbounded body. Endpoints that read a whole upload into memory
# (voice transcription, imports, backup restore) enforce their own tighter
# caps on top.
MAX_BODY_BYTES=536870912

# --- Retrieval tuning ---
# Minimum probability for the locally trained intent classifier to answer on
# its own (Tier 1.5, between local retrieval and the external AI classifier).
INTENT_TRUST_THRESHOLD=0.6

# Hybrid retrieval: BM25 + dense candidates fused by the feature reranker.
# Set to false to fall back to plain dense-argmax ranking — the instant
# rollback if the reranker misbehaves on a customer's own corpus.
RETRIEVAL_RERANK=true

# Where the local embedding model is cached. The app pins this to data/models
# unless HF_HOME is already set in the environment.
# HF_HOME=/absolute/path/to/model-cache

# --- Registration module: visit taxonomy ---
# Path to the JSON that drives the registration form and the visit planner
# (jobs, interests, flags, sections). Defaults to data/visit-taxonomy.json.
# Edits are picked up without a restart; a malformed file is rejected and the
# last good version keeps serving.
# VISIT_TAXONOMY_PATH=/absolute/path/to/visit-taxonomy.json

# --- Registration module: OTP behaviour ---
# All limits are enforced server-side; the UI timer is presentation only.
# Digits in the verification code.
OTP_LENGTH=6
# How long a code stays valid, in seconds.
OTP_TTL_SECONDS=120
# Seconds a visitor must wait before requesting another code.
OTP_RESEND_COOLDOWN=45
# Wrong-code tries before the challenge is dead.
OTP_MAX_ATTEMPTS=5
# Resends allowed per challenge.
OTP_MAX_RESENDS=3
# New challenges per phone number per hour (anti SMS-pumping).
OTP_DEST_HOURLY_LIMIT=5

# Delivery provider. "dev" appends codes to data/otp-dev-outbox.log (gitignored)
# so a developer can complete the flow locally. It is REFUSED when
# COOKIE_SECURE=true — a production install must name a real provider (asanak).
OTP_DELIVERY=dev

# Host used in the WebOTP autofill line of the SMS body (`@<host> #<code>`).
# Chrome on Android only offers autofill when the message ends with exactly
# that, so set it to the domain that serves /verify. Leave empty to omit.
OTP_SMS_HOST=

# --- Registration module: Asanak SMS gateway ---
# PRECEDENCE for every value below: the `settings` table (entered once in the
# admin panel) wins first, then this env var, then the built-in default.
#
# SAVING FROM THE ADMIN PANEL WRITES THIS FILE. When an operator saves
# Settings -> SMS, the app updates the ASANAK_* / OTP_* keys below in place
# (other keys and these comments are preserved, the file is rewritten
# atomically and left chmod 0600, and a timestamped copy is put in backups/).
# The two secrets are stored ENCRYPTED and look like:
#   ASANAK_PASSWORD=enc:gAAAAAB...
# The key is derived from SECRET_KEY (or the auto-generated app secret in the
# database) — see the warning next to SECRET_KEY above. A plain, unencrypted
# value typed here by hand keeps working: only the `enc:` prefix means
# "encrypted".
#
# All three of username/password/source must be present for the provider to
# count as configured — a half-filled set makes the app report "SMS not
# configured" rather than fail at send time.
# ASANAK_USERNAME=your-asanak-username
# ASANAK_PASSWORD=your-asanak-password
# ASANAK_SOURCE=your-asanak-sender-number

# Optional. Asanak's documented send path authenticates with username +
# password in the request body; there is no published API-key scheme, so this
# is stored (encrypted) but not used when sending.
# ASANAK_API_KEY=

# Gateway endpoints. Only override for a private or staging gateway — or for
# an account still served by the older panel.asanak.com host.
# Defaults (documented at asanak.com/api-docs, host sms.asanak.ir):
#   https://sms.asanak.ir/webservice/v2rest/sendsms
#   https://sms.asanak.ir/webservice/v2rest/msgstatus
#   https://sms.asanak.ir/webservice/v2rest/getcredit
# ASANAK_URL=
# ASANAK_STATUS_URL=
# ASANAK_CREDIT_URL=

# Asanak strips leading/trailing whitespace by default. Set to false only if
# your message template depends on that whitespace. Verification codes do not.
# NOTE: `trim` is not in Asanak's public documentation; it is sent only when
# set to false.
# ASANAK_TRIM=true

# 0 = never deliver to numbers on Asanak's blacklist. Asanak's own default is 1.
# ASANAK_SEND_TO_BLACKLIST=1

# --- Approved templates that carry a LINK (exhibition lead capture) ---
# ASANAK_TEMPLATE_ID above carries the verification code. These two carry the
# edit link, and they are separate ids because Asanak approves a template per
# TEXT: "here is your edit link" and "your text was not approved, here is a
# fresh link" are two different approvals. Neither falls back to the other.
#
# BEFORE YOU SET THESE, read this. Measured against the live account on
# 2026-08-17: free text never reaches a handset here, only an approved
# template does. And Asanak error 1014 is literally "the sender line is not
# permitted to send links". Sending a link is a permission this account has
# not been granted yet, and whether a link passes as a template PARAMETER
# where free text is refused has NOT been verified (there is no approved link
# template to try). So leave the invite channel on QR until you have both the
# approved template and the link permission. With these empty, or with the
# permission missing, the invite send fails with the gateway's own reason and
# the booth shows a QR code instead. It never fails silently.
#
# The approved template must name its parameter `link`.
# ASANAK_INVITE_TEMPLATE_ID=
# ASANAK_REJECT_TEMPLATE_ID=

# --- Daily SMS spend cap ---
# Total messages this install may send per day, counted across ALL three
# kinds: verification codes, invite links and rejection notices. They come off
# one Asanak credit, so one number bounds the bill.
#
# This is NOT the same control as OTP_DEST_HOURLY_LIMIT. That one is per phone
# NUMBER, so it bounds nothing about total spend: walking the 09xx range, or a
# loop that retries, bills the account without limit.
#
# 0 means no cap, and that is the default so an upgrade never starts refusing
# messages against a number nobody chose. Set a real one before an event. A
# useful starting point for a two-day exhibition with 700-900 companies: one
# code plus one or two resends plus one invite per registration, so roughly
# 4 messages per company. 900 companies over 2 days is about 1800 messages a
# day, and 2000 leaves headroom without letting a bug drain the account.
# Counting resets at UTC midnight.
#
# Crossing the cap refuses the next send and writes a critical applog alarm
# (sms.budget.exhausted); 80 percent of it writes a warning (sms.budget.low).
# SMS_DAILY_BUDGET=0
