# WHY ONESHOT + TIMER, NOT A DAEMON: watchdog.py runs exactly one probe per
# invocation and exits. There is no loop code to hang or drift, no schedule
# to own, and no state to rebuild after a reboot — systemd (via
# padyar-watchdog@.timer) owns the cadence, and one failed tick never stops
# the next one from firing.
[Unit]
Description=Padyar critical watchdog — %i
After=network-online.target

[Service]
Type=oneshot
# A oneshot unit has no start timeout by default, so a process that never
# finishes would hold this install's watchdog forever, the down-SMS included.
# 300s ends only a truly stuck run (SIGTERM, unit marked failed). It is long on
# purpose: the down-SMS and the low-credit SMS save state only at the end of a
# cycle, so a shorter timeout that killed a slow but working cycle after one
# of them would make the next cycle send it again. An Alertmanager stall is
# already cut by the 8s per-GET deadline in watchdog.py, and a run still in
# progress makes the 60s timer skip a tick, never overlap.
TimeoutStartSec=300s
User=padyar-%i
Group=padyar-%i
# CWD + .env of the guarded install: the cycle lazily imports the app's DB
# layer (app.db.queries) to read the alert phone, and that import resolves
# config relative to the install it belongs to.
WorkingDirectory=/opt/padyar-%i
# Python puts the SCRIPT's directory (/opt/padyar-watchdog) on sys.path, not
# the working directory. Without this line `import app` fails on every cycle
# and the watchdog can read no phone and send no SMS.
Environment=PYTHONPATH=/opt/padyar-%i
EnvironmentFile=/opt/padyar-%i/.env
ExecStart=/opt/padyar-%i/.venv/bin/python /opt/padyar-watchdog/watchdog.py --install %i
# Hardening. The cycle writes only its state file under /var/lib/padyar-watchdog.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/padyar-watchdog
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=padyar-watchdog-%i
