# WHY WEEKLY: the INOTEX official pages move on the scale of weeks, not
# minutes — the knowledge seed was verified by hand on 2026-08-14, and the
# cost of catching a change six days late is a human review task, nothing
# more. Persistent=true means a week the host was down does not silently
# skip the check: the missed elapse fires on the next boot.
[Unit]
Description=Run the Padyar INOTEX freshness check weekly — %i

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=timers.target
