# WHY ONESHOT + TIMER, NOT PART OF THE APP: the freshness checker runs
# exactly once a week, needs no state of its own, and must never be able to
# touch the database. systemd (via padyar-freshness@.timer) owns the
# cadence; one failed or unreachable week never stops the next tick.
[Unit]
Description=Padyar INOTEX content-freshness check — %i
After=network-online.target

[Service]
Type=oneshot
User=padyar-%i
Group=padyar-%i
# The checker resolves everything from its own path; no app import, no .env,
# no DB — its whole contract is "read sources.json, write content/ only".
WorkingDirectory=/opt/padyar-%i
ExecStart=/opt/padyar-%i/.venv/bin/python /opt/padyar-%i/scripts/refresh-inotex-context.py
# Exit 2 = a source page changed (that is the finding, not a failure), 3 = a
# source unreachable (last good snapshot kept). Neither may mark the unit
# failed — a weekly timer whose unit goes red on its own report would train
# operators to ignore the state.
SuccessExitStatus=2 3
# Hardening. ProtectSystem=strict leaves the WHOLE filesystem read-only
# except the paths below, so "this script never writes to the database" is
# enforced by the unit, not just by convention: snapshots + report under
# content/ are the only writes it is allowed to make.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/padyar-%i/content
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=padyar-freshness-%i
