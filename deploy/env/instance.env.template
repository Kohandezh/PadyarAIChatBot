# /opt/padyar-<SLUG>/.env  —  <DOMAIN>
#
# Copy to /opt/padyar-<SLUG>/.env, fill every <PLACEHOLDER>, chmod 0600.
# app/prodcheck.py REFUSES to start with a placeholder left in, on purpose.

# --- environment gate -------------------------------------------------------
# The ONLY thing that turns the production checks on.
PADYAR_ENV=production

# --- security ---------------------------------------------------------------
COOKIE_SECURE=true
# openssl rand -hex 32   — DIFFERENT value per install, and never change it
# afterwards: the key that decrypts stored enc: secrets is derived from it.
SECRET_KEY=<PASTE 64 HEX CHARS>
ALLOWED_ORIGINS=<YOUR DOMAIN, e.g. myevent.example.com>

# First-install admin only. Leave ADMIN_PASSWORD empty to have one generated
# into ADMIN_CREDENTIALS.txt, which is the safer option.
ADMIN_USERNAME=<PICK A USERNAME>
ADMIN_PASSWORD=
ADMIN_SECURITY_ANSWER=<PICK AN ANSWER>

# --- database ---------------------------------------------------------------
DB_BACKEND=postgres
DATABASE_URL=postgresql://padyar_<SLUG>:<PASSWORD FROM 05-create-databases.sh>@127.0.0.1:5432/padyar_<SLUG>
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT=10
DB_POOL_MAX_LIFETIME=1800

# --- server -----------------------------------------------------------------
# Read by the systemd unit's ExecStart. Multiply WEB_CONCURRENCY x
# DB_POOL_MAX_SIZE, then by the number of installs on this host, and stay
# under PostgreSQL's max_connections (default 100).
WEB_CONCURRENCY=3
# Do not set PROMETHEUS_MULTIPROC_DIR here: the systemd unit owns it, and a value here would override the unit's.
# The install's port — the single source of truth on the host. The systemd
# unit's uvicorn (--port ${APP_PORT}) and the watchdog probe read it from
# here; deploy/15-nginx-and-ssl.sh and the padyar-deploy command must be told the SAME
# number. One port per install (e.g. 8010); never reuse it.
APP_PORT=<PICK A PORT, e.g. 8010>
LOG_FORMAT=json

# --- AI provider ------------------------------------------------------------
# Bootstrap values only; Admin -> AI -> Providers overrides both once set.
OPENAI_API_KEY=<REAL KEY>
OPENAI_API_BASE=https://api.gapgpt.app/v1

# --- modules ----------------------------------------------------------------
ENABLED_MODULES=voice,video,infra,backups,ops,logs,tts

# --- text to speech ---------------------------------------------------------
# The Chatterbox service from deploy/25-install-tts.sh, on loopback.
TTS_URL=http://127.0.0.1:8003

# --- SMS / OTP --------------------------------------------------------------
# OTP_DELIVERY=dev is a production BLOCKER even when the registration module is
# disabled — prodcheck.py checks the env var, not the module list. Leave this
# as asanak on every install.
OTP_DELIVERY=asanak
OTP_SMS_HOST=<YOUR DOMAIN, e.g. myevent.example.com>
# Credentials are better entered in Admin -> Settings -> SMS (stored encrypted).
# ASANAK_USERNAME=
# ASANAK_PASSWORD=
# ASANAK_SOURCE=

# --- off-site backup copy ---------------------------------------------------
# Without this, every pg_dump stays on the same host as the database it
# protects. Set a target and each VERIFIED dump is copied there after the
# nightly backup (rsync over ssh needs key-based login, no password prompt).
#   rsync:user@host:/srv/padyar-backups   or   dir:/mnt/offsite-backup
# A copy failure is never fatal — it is logged as a service event
# (backup.offsite.failed) and the local backup stays valid.
# OFFSITE_BACKUP_TARGET=
# OFFSITE_BACKUP_TIMEOUT=600

# --- retrieval --------------------------------------------------------------
INTENT_TRUST_THRESHOLD=0.6
RETRIEVAL_RERANK=true
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60
