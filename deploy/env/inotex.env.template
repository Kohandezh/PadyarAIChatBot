# /opt/padyar-inotex/.env  —  inotex.padyar.com
#
# Copy to /opt/padyar-inotex/.env, fill every <PLACEHOLDER>, chmod 0600.
# app/prodcheck.py REFUSES to start with a placeholder left in, on purpose.

# --- environment gate -------------------------------------------------------
# The ONLY thing that turns the production checks on.
PADYAR_ENV=production

# --- security ---------------------------------------------------------------
COOKIE_SECURE=true
# openssl rand -hex 32   — DIFFERENT value per install, and never change it
# afterwards: the key that decrypts stored enc: secrets is derived from it.
SECRET_KEY=<PASTE 64 HEX CHARS>
ALLOWED_ORIGINS=inotex.padyar.com,inotex.pwa.padyar.com

# First-install admin only. Leave ADMIN_PASSWORD empty to have one generated
# into ADMIN_CREDENTIALS.txt, which is the safer option.
ADMIN_USERNAME=<PICK A USERNAME>
ADMIN_PASSWORD=
ADMIN_SECURITY_ANSWER=<PICK AN ANSWER>

# --- database ---------------------------------------------------------------
DB_BACKEND=postgres
DATABASE_URL=postgresql://padyar_inotex:<PASSWORD FROM 05-create-databases.sh>@127.0.0.1:5432/padyar_inotex
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT=10
DB_POOL_MAX_LIFETIME=1800

# --- server -----------------------------------------------------------------
# Read by the systemd unit's ExecStart. 3 workers x 5 pool x 2 apps = 30
# connections, comfortably under the default max_connections of 100.
WEB_CONCURRENCY=3
HOST=127.0.0.1
PORT=8001
LOG_FORMAT=json

# --- AI provider ------------------------------------------------------------
# Bootstrap values only; Admin -> AI -> Providers overrides both once set.
OPENAI_API_KEY=<REAL KEY>
OPENAI_API_BASE=https://api.gapgpt.app/v1

# --- modules ----------------------------------------------------------------
ENABLED_MODULES=voice,video,registration,pwa_api,infra,backups,ops,logs,tts

# --- text to speech ---------------------------------------------------------
# The Chatterbox service from deploy/20-gpu-chatterbox.sh, on loopback.
TTS_URL=http://127.0.0.1:8003

# --- SMS / OTP --------------------------------------------------------------
# OTP_DELIVERY=dev is a production BLOCKER even when the registration module is
# disabled — prodcheck.py checks the env var, not the module list. Leave this
# as asanak on both installs.
OTP_DELIVERY=asanak
OTP_SMS_HOST=inotex.padyar.com
# Credentials are better entered in Admin -> Settings -> SMS (stored encrypted).
# ASANAK_USERNAME=
# ASANAK_PASSWORD=
# ASANAK_SOURCE=

# --- retrieval --------------------------------------------------------------
INTENT_TRUST_THRESHOLD=0.6
RETRIEVAL_RERANK=true
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60
# How often (seconds) a worker re-checks the shared search-index version stamp.
# Content edits reach every worker within this window without a restart.
SEARCH_INDEX_REFRESH_SECONDS=5
# Process-local TTL (seconds) for cached settings reads. 0 disables caching.
SETTINGS_CACHE_TTL=15
# Max simultaneous external AI calls per worker. Past the cap, requests queue
# instead of fanning out onto the provider. 0 disables the gate.
AI_MAX_CONCURRENCY=16
